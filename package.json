{
  "name": "ncaa-football-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test scripts/refresh-data/__tests__/*.test.ts src/data/__tests__/*.test.ts src/pages/__tests__/*.test.tsx",
    "data:fixtures": "node --import tsx scripts/refresh-data/index.ts --fixtures",
    "data:rebuild-derived": "node --import tsx scripts/rebuild-derived.ts",
    "data:refresh": "node --import tsx scripts/refresh-data/index.ts",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "check": "npm test && npm run data:validate && npm run build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
